# Copy this file to server/.env.local for development or
# server/.env.production for production. docker-compose.yml passes these
# settings to the containers.
#
# Environment variables marked #REQ do not have a default and must be set.

# ============================================================================
# Deployment images
# ============================================================================
# Optional credential-bearing proxy used only when restart.sh is invoked with
# --use-proxy. Keep the real value only in the mode-0600 deployment env file;
# it is passed to Docker as a predefined, non-persisted build argument.
# REVODESIGN_BUILD_PROXY=

# Dev mode builds these names locally. Prod mode pulls them, so production must
# use published references such as:
#   yaoyinying/revodesign-revocompute-server:latest
SERVER_IMAGE=revodesign-revocompute-server

# Docker Compose project name — isolates containers, networks, and volumes.
# Defaults to the parent directory name.  Set this when running multiple
# deployments side-by-side (e.g. a production stack and a SLURM stack).
# COMPOSE_PROJECT_NAME=server

# ============================================================================
# Storage paths and databases — must exist on the Docker host
# ============================================================================
# #REQ Root directory for uploads, results, and the SQLite task database.
SERVER_DIR=/srv/revodesign/server
# Host directory that the Docker runner may bind from. Defaults to the parent
# of SERVER_DIR; set this when SERVER_DIR is under a symlink or alternate mount.
# RUNNER_HOST_ROOT=/srv/revodesign
# Directory for Gunicorn, Celery, and maintenance log files.
LOG_DIR=/srv/revodesign/logs
# Directory containing task_types.yaml and runners/.  Defaults to the config/
# directory shipped in the Docker image; set this to use host-side config files
# for live editing without rebuilding the image.
# CONFIG_DIR=

# AUTH_DIR is a path on the Docker host, not a path inside the container.
# Compose mounts this directory only into the web and maintenance containers:
#
#   host: /srv/revodesign/auth
#     -> web container: /var/lib/revodesign-auth
#     -> maintenance container: /var/lib/revodesign-auth
#     -> worker container: not mounted
#
# Keep it outside SERVER_DIR. The complete SERVER_DIR is mounted into both web
# and worker, so putting AUTH_DIR underneath SERVER_DIR would expose users.sqlite3
# to the worker through the parent mount.
AUTH_DIR=/srv/revodesign/auth
# USER_DB_PATH is the path seen by web and maintenance inside their containers.
# It maps to ${AUTH_DIR}/users.sqlite3 on the host and should normally be left
# unchanged.
USER_DB_PATH=/var/lib/revodesign-auth/users.sqlite3

# ============================================================================
# Authentication and access control
# ============================================================================
# The server generates an in-memory signing key on each launch. Restarting the
# web service logs users out and invalidates outstanding verification/reset
# links; no signing secret is stored in this file.
# Token lifetime in seconds (default: 604800 = 7 days).
# AUTH_TOKEN_MAX_AGE=604800
# #REQ Comma-separated first-start administrator usernames. On an empty user
# database, the restart script creates each listed administrator and prints a
# distinct generated password. After bootstrap, database roles control access.
ADMIN_USERS=admin
# Do not store administrator bootstrap passwords in this file.

# ============================================================================
# Registration settings — self-service registration requires email service
# ============================================================================
# Set to true to show the /register page and enable the registration API.
ENABLE_REGISTER=false

# Comma-separated list of allowed email domains for self-registration.
# Empty (default) = all domains allowed. Also normalises plus-aliased
# addresses (user+tag@domain → user@domain).
# Example: "institution.edu,lab.org"
# ALLOWED_EMAIL_DOMAINS=

# Admin new-user digest: the maintenance scheduler periodically emails a table
# of registrations that have not appeared in a prior digest.
# Each user is included only once (flagged in the DB after first send).
# Comma-separated list of admin email addresses to receive the digest.
# ADMIN_NOTIFY_EMAIL=admin@lab.org,admin2@lab.org
# Interval in minutes between digest emails. Set to 0 (or leave unset) to
# disable the digest job entirely.
# ADMIN_NEW_USER_INFORM=60

# ============================================================================
# Email settings — verification, password reset, and admin notifications
# ============================================================================
# SMTP (stdlib, always available — no extra dependencies).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDR=hello@revodesign.local
# SMTP_FROM_NAME="REvoDesign GREMLIN Server"

# Resend (pip extra 'resend', takes priority over SMTP when the package is
# installed with the [resend] extra and RESEND_API_KEY is non-empty).
# https://resend.com/
# RESEND_API_KEY=re_...
# RESEND_FROM_ADDR=onboarding@resend.dev
# RESEND_FROM_NAME="REvoDesign GREMLIN Server"

# Public base URL used to generate links in verification, password-reset,
# and admin-digest emails.  Defaults to http://localhost:8080.
# SERVER_BASE_URL=http://localhost:8080

# ============================================================================
# Redis — message broker and result backend for Celery
# ============================================================================
# Redis is authenticated. `restart.sh setup` generates REDIS_PASSWORD and
# persists it in this file; the compose stack then applies it both to
# redis-server (--requirepass) and to the Celery URIs.
# Uncomment REDIS_URL/BROKER_URL/RESULT_BACKEND only to point at an external
# Redis, and include the password in the URI (redis://:<password>@host:6379/0).
# REDIS_PASSWORD=
# REDIS_URL=redis://:<password>@redis-host:6379/0
# BROKER_URL=redis://:<password>@redis-host:6379/0
# RESULT_BACKEND=redis://:<password>@redis-host:6379/0

# ============================================================================
# Runner settings — non-root container identity
# ============================================================================
# restart.sh auto-derives numeric UID/GID from RUNNER_USERNAME /
# RUNNER_GROUP via `id -u` / `getent group`.  Uncomment and set these overrides
# when name-based resolution doesn't work (e.g. macOS where the container user
# doesn't exist on the host — use `id -u` / `id -g` for the current user).
#
# Mode contract:
# - restart --mode=dev may use the deployment host's UID/GID so local bind
#   mounts remain writable.
# - restart --mode=prod uses published images built for UID/GID 1000:1000 and
#   rejects any other values. Provision writable host directories accordingly.
RUNNER_USERNAME=revodesign
RUNNER_GROUP=revodesign_appgroup
# RUNNER_UID=1000
# RUNNER_GID=1000

# ============================================================================
# Resource settings
# ============================================================================
# Memory limit in GB passed to hhblits inside each runner.
MAXMEM=64
# Celery worker concurrency (one worker process, this many concurrent jobs).
WORKER_CONCURRENCY=2

# ============================================================================
# Maintenance scheduler settings
# ============================================================================
# Set a positive number of days to delete terminal-task result trees, immutable
# input snapshots, and optional archive caches. Fractions are allowed (for
# example, 0.1 = 2.4 hours). Leave unset to disable cleanup; audit rows remain.
# RESULT_RETENTION_DAYS=
#
# Database snapshots are disabled when BACKUP_DB_CRON is unset. The recommended
# schedule below runs daily at 00:00 in TZ. BACKUP_DB_PATH is a path inside the
# maintenance container; keeping it below /var/lib/revodesign-auth persists the
# snapshots at ${AUTH_DIR}/backups on the host without exposing them to worker.
# BACKUP_DB_CRON="0 0 * * *"
# BACKUP_DB_PATH=/var/lib/revodesign-auth/backups
# Retain the newest 30 complete snapshot sets. Leave unset for unlimited history.
# MAX_DB_BACKUP=30
#
# ZIP and copy-truncate every *.log file in LOG_DIR. Any setting below enables
# the task; leave all three unset to disable it. Line rotation occurs after the
# configured count is exceeded and is checked hourly. Scheduled rotation uses a
# quoted five-field crontab expression in TZ.
# ROTATE_LOG_MAX_LINENO=100000
# ROTATE_LOG_PERIOD="0 0 * * *"
# Cap the combined size of active logs and their ZIP archives. Oldest ZIPs are
# removed first; active logs are rotated only when that is insufficient. A ZIP
# created in the current pass is retained even when it temporarily exceeds cap.
# Accepts bytes or K/M/G/T suffixes. Leave unset to disable the size cap.
# MAX_LOG_SIZE=1G

# ============================================================================
# Web settings
# ============================================================================
# Public HTTP port.
PORT=8080
# Gunicorn worker count for the Flask web process.
GUNICORN_WORKERS=2
# Force the auth cookie's Secure flag even if the proxy chain fails to
# report HTTPS. Enable only on HTTPS-only deployments (plain-HTTP clients
# would otherwise stop receiving the cookie).
# AUTH_COOKIE_SECURE=true
# Web requests exceeding this duration are terminated. Result ZIP bytes are
# served by Nginx and do not occupy Gunicorn for the transfer duration.
GUNICORN_TIMEOUT=120
# Production uses the Nginx gateway's internal result location. Set to flask
# only when running the Flask container directly for local development.
RESULT_DOWNLOAD_MODE=nginx

# ============================================================================
# Client IP resolution — for logging and registration tracking
# ============================================================================
# Comma-separated list of HTTP headers to try for the real client IP,
# checked in priority order (first non-empty value wins).
#
# CDN / proxy header quick reference:
#   Cloudflare            CF-Connecting-IP            CF-IPCountry
#   Akamai                True-Client-IP
#   AWS CloudFront        CloudFront-Viewer-Address   CloudFront-Viewer-Country
#   Fastly                Fastly-Client-IP
#   Azure Front Door      X-Azure-ClientIP
#   Fly.io                Fly-Client-IP
#   Netlify               X-Nf-Client-Connection-IP
#   nginx / Traefik / Caddy / GCP / generic  X-Forwarded-For
#
# To trust only the CDN's unstrippable header, put it first and X-Forwarded-For
# last as a fallback.  Example for Cloudflare:
#   CLIENT_IP_HEADERS="CF-Connecting-IP, X-Forwarded-For, X-Real-IP"
#   CLIENT_COUNTRY_HEADER="CF-IPCountry"
#
# Leave both unset (or empty) to use request.remote_addr directly.
# CLIENT_IP_HEADERS="X-Forwarded-For, X-Real-IP"
# CLIENT_COUNTRY_HEADER=

# ============================================================================
# Logging
# ============================================================================
# Timezone for log timestamps (e.g. Europe/London, Asia/Shanghai, UTC).
TZ=Europe/London
