# Copy this file to server/.env.local for development or
# server/.env.production for production. docker-compose.yml passes these
# settings to the containers.
#
# Environment variables marked #REQ do not have a default and must be set.

# ============================================================================
# Deployment images
# ============================================================================
# Dev mode builds these names locally. Prod mode pulls them, so production must
# use published references such as:
#   yaoyinying/revodesign-pssm-gremlin-server-non-root:latest
#   yaoyinying/revodesign-pssm-gremlin-non-root:latest
SERVER_IMAGE=revodesign-pssm-gremlin-server-non-root
RUNNER_IMAGE=revodesign-pssm-gremlin-non-root

# ============================================================================
# Storage paths and databases — must exist on the Docker host
# ============================================================================
# Root directory for uploads, results, and the SQLite task database.
SERVER_DIR=/srv/revodesign/server
# Host directory that the Docker runner may bind from. Defaults to the parent
# of SERVER_DIR; set this when SERVER_DIR is under a symlink or alternate mount.
# RUNNER_HOST_ROOT=/srv/revodesign
# Directory for Gunicorn and Celery log files.
LOG_DIR=/srv/revodesign/logs

# AUTH_DIR is a path on the Docker host, not a path inside the container.
# Compose mounts this directory only into the web container:
#
#   host: /srv/revodesign/auth
#     -> web container: /var/lib/revodesign-auth
#     -> worker container: not mounted
#
# Keep it outside SERVER_DIR. The complete SERVER_DIR is mounted into both web
# and worker, so putting AUTH_DIR underneath SERVER_DIR would expose users.sqlite3
# to the worker through the parent mount.
AUTH_DIR=/srv/revodesign/auth
# USER_DB_PATH is the path seen by the web process inside its container. It maps
# to ${AUTH_DIR}/users.sqlite3 on the host and should normally be left unchanged.
USER_DB_PATH=/var/lib/revodesign-auth/users.sqlite3

# Large read-only MSA databases mounted into the runner container.
# Prefix for the UniRef30 HHblits database (the directory containing the .cs219
# and .a3m files; omit extensions).
DB_UNIREF30=/srv/revodesign/databases/uniref30/UniRef30_2023_02
# Prefix for the UniRef90 BLAST database (the directory containing the .pin/.phr
# etc. files; omit extensions).
DB_UNIREF90=/srv/revodesign/databases/uniref90/uniref90

# ============================================================================
# Authentication and access control
# ============================================================================
# Secret key for signing auth tokens.  #REQ in production: set a fixed,
# high-entropy value (e.g. `openssl rand -hex 32`) so tokens survive
# gunicorn/celery restarts.  If left empty a random key is generated per
# process, which breaks tokens after every restart.
# AUTH_SECRET_KEY=
# Token lifetime in seconds (default: 604800 = 7 days).
# AUTH_TOKEN_MAX_AGE=604800
# Comma-separated usernames granted access to all tasks, user management, and
# admin API routes.
ADMIN_USERS=admin

# ============================================================================
# Registration settings — self-service registration requires email service
# ============================================================================
# Set to true to show the /register page and enable the registration API.
ENABLE_REGISTER=false

# Comma-separated list of allowed email domains for self-registration.
# Empty (default) = all domains allowed. Also normalises plus-aliased
# addresses (user+tag@domain → user@domain).
# Example: "institution.edu,lab.org"
# ALLOWED_EMAIL_DOMAINS=

# Admin new-user digest: a background thread in the web process periodically
# emails a table of registrations that have not appeared in a prior digest.
# Each user is included only once (flagged in the DB after first send).
# Comma-separated list of admin email addresses to receive the digest.
# ADMIN_NOTIFY_EMAIL=admin@lab.org,admin2@lab.org
# Interval in minutes between digest emails. Set to 0 (or leave unset) to
# disable the digest thread entirely.
# ADMIN_NEW_USER_INFORM=60

# ============================================================================
# Email settings — verification, password reset, and admin notifications
# ============================================================================
# SMTP (stdlib, always available — no extra dependencies).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDR=hello@revodesign.local
# SMTP_FROM_NAME="REvoDesign GREMLIN Server"

# Resend (pip extra 'resend', takes priority over SMTP when the package is
# installed with the [resend] extra and RESEND_API_KEY is non-empty).
# https://resend.com/
# RESEND_API_KEY=re_...
# RESEND_FROM_ADDR=onboarding@resend.dev
# RESEND_FROM_NAME="REvoDesign GREMLIN Server"

# Public base URL used to generate links in verification, password-reset,
# and admin-digest emails.  Defaults to http://localhost:8080.
# SERVER_BASE_URL=http://localhost:8080

# ============================================================================
# Redis — message broker and result backend for Celery
# ============================================================================
REDIS_URL=redis://redis:6379/0
BROKER_URL=redis://redis:6379/0
RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# Runner settings — non-root container identity
# ============================================================================
# restart_pssm_flask.sh auto-derives numeric UID/GID from RUNNER_USERNAME /
# RUNNER_GROUP via `id -u` / `getent group`.  Uncomment and set these overrides
# when name-based resolution doesn't work (e.g. macOS where the container user
# doesn't exist on the host — use `id -u` / `id -g` for the current user).
#
# Mode contract:
# - restart --mode=dev may use the deployment host's UID/GID so local bind
#   mounts remain writable.
# - restart --mode=prod uses published images built for UID/GID 1000:1000 and
#   rejects any other values. Provision writable host directories accordingly.
RUNNER_USERNAME=revodesign
RUNNER_GROUP=revodesign_appgroup
# RUNNER_UID=1000
# RUNNER_GID=1000

# ============================================================================
# Resource settings
# ============================================================================
# Number of CPU cores exposed to each runner container. Total concurrent
# jobs = WORKER_CONCURRENCY; total CPU usage ≈ NPROC × WORKER_CONCURRENCY.
NPROC=4
# Memory limit in GB passed to hhblits inside each runner.
MAXMEM=64
# Celery worker concurrency (one worker process, this many concurrent jobs).
WORKER_CONCURRENCY=2

# ============================================================================
# Web settings
# ============================================================================
# Public HTTP port.
PORT=8080
# Gunicorn worker count for the Flask web process.
GUNICORN_WORKERS=2
# Delete result directories and archives for terminal tasks after this many days.
# The cleanup runs daily; task audit rows are retained. Set to 0 to disable.
RESULT_RETENTION_DAYS=30
# Scope task dashboard to the logged-in user (false, default) or show all
# tasks to everyone (true, for public-facing deployments without auth).
PUBLIC_DASHBOARD=false

# ============================================================================
# Client IP resolution — for logging and registration tracking
# ============================================================================
# Comma-separated list of HTTP headers to try for the real client IP,
# checked in priority order (first non-empty value wins).
#
# CDN / proxy header quick reference:
#   Cloudflare            CF-Connecting-IP            CF-IPCountry
#   Akamai                True-Client-IP
#   AWS CloudFront        CloudFront-Viewer-Address   CloudFront-Viewer-Country
#   Fastly                Fastly-Client-IP
#   Azure Front Door      X-Azure-ClientIP
#   Fly.io                Fly-Client-IP
#   Netlify               X-Nf-Client-Connection-IP
#   nginx / Traefik / Caddy / GCP / generic  X-Forwarded-For
#
# To trust only the CDN's unstrippable header, put it first and X-Forwarded-For
# last as a fallback.  Example for Cloudflare:
#   CLIENT_IP_HEADERS="CF-Connecting-IP, X-Forwarded-For, X-Real-IP"
#   CLIENT_COUNTRY_HEADER="CF-IPCountry"
#
# Leave both unset (or empty) to use request.remote_addr directly.
# CLIENT_IP_HEADERS="X-Forwarded-For, X-Real-IP"
# CLIENT_COUNTRY_HEADER=

# ============================================================================
# Logging
# ============================================================================
# Timezone for log timestamps (e.g. Europe/London, Asia/Shanghai, UTC).
TZ=Europe/London
