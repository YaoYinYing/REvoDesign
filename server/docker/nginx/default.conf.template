worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    client_max_body_size 16m;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    map $http_x_forwarded_proto $origin_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    server {
        listen 8080;
        server_name _;

        location / {
            proxy_pass http://web:${UPSTREAM_PORT};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $origin_proto;
        }

        location /_protected_results/ {
            internal;
            alias /srv/results/;
            disable_symlinks on;
            limit_except GET {
                deny all;
            }
            sendfile on;
            tcp_nopush on;
            default_type application/zip;
            add_header X-Content-Type-Options nosniff always;
            # Runner-controlled artifacts must never execute scripts same-origin.
            add_header Content-Security-Policy "sandbox" always;
        }
    }
}
